# ============================================================
# TASKPRO - CONFIGURATION ENVIRONNEMENT
# ============================================================

# --- BASE DE DONNÉES ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskpro_db
DB_USER=root
DB_PASS=

# --- SERVEUR APPLICATION ---
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost/Task-Pro

# --- SESSIONS ---
SESSION_TIMEOUT=3600
SESSION_SECURE=false
SESSION_HTTPONLY=true
SESSION_SAMESITE=Lax

# --- SÉCURITÉ ---
ENCRYPTION_KEY=your-secret-encryption-key-here-change-in-production
HASH_ALGORITHM=bcrypt

# --- EMAIL/SMTP ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=uchiwai215@gmail.com
MAIL_PASSWORD=hxgnmdniqfduotou
MAIL_FROM=uchiwai215@gmail.com
MAIL_FROM_NAME="TaskPro"
MAIL_ENCRYPTION=tls

# --- FICHIERS ---
MAX_UPLOAD_SIZE=10485760
UPLOAD_PATH=/uploads
ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,zip,jpg,png

# --- API ---
API_RATE_LIMIT=1000
API_RATE_WINDOW=3600

# --- LOGGING ---
LOG_LEVEL=info
LOG_PATH=/logs
